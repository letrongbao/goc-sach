<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd" version="3.0">
  <persistence-unit name="bookstore" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <mapping-file>META-INF/orm.xml</mapping-file>
    <mapping-file>META-INF/shop-orm.xml</mapping-file>
    <mapping-file>META-INF/inventory-orm.xml</mapping-file>
    <mapping-file>META-INF/buyer-orm.xml</mapping-file>
    <mapping-file>META-INF/order-orm.xml</mapping-file>
    <mapping-file>META-INF/payment-orm.xml</mapping-file>
    <mapping-file>META-INF/review-orm.xml</mapping-file>
    <mapping-file>META-INF/media-orm.xml</mapping-file>
    <mapping-file>META-INF/operations-orm.xml</mapping-file>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="hibernate.hbm2ddl.auto" value="validate"/>
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.jdbc.time_zone" value="UTC"/>
      <property name="hibernate.connection.provider_class" value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
      <property name="hibernate.hikari.maximumPoolSize" value="8"/>
      <property name="hibernate.hikari.connectionTimeout" value="10000"/>
    </properties>
  </persistence-unit>
</persistence>
