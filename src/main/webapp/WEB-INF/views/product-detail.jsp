<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<section class="container section"><a class="back-link" href="<c:url value='/product'/>">← Khám phá tủ sách</a><div class="detail-grid"><div class="detail-art"><c:choose><c:when test="${not empty product.image}"><c:url var="coverUrl" value="${product.image}"/><img src="<c:out value='${coverUrl}'/>" alt="Bìa sách <c:out value='${product.title}'/>"></c:when><c:otherwise><div class="typographic-cover"><small>GÓC SÁCH / TUYỂN CHỌN</small><span><c:out value="${product.title}"/></span><em><c:out value="${product.author}"/></em></div></c:otherwise></c:choose></div><div class="detail-info"><p class="eyebrow"><c:out value="${product.categoryName}"/></p><h1><c:out value="${product.title}"/></h1><p class="muted">Tác giả: <c:out value="${product.author}"/></p><div class="detail-price"><fmt:formatNumber value="${product.price}" maxFractionDigits="2"/> ₫</div><p class="status stock-label">${product.stock > 0 ? 'Còn sách' : 'Tạm hết sách'} · <c:out value="${product.stock}"/> cuốn</p><h3>Về cuốn sách</h3><p class="description"><c:out value="${product.description}"/></p><p class="form-note">Bản học tập hiện tại chưa hỗ trợ đặt hàng hoặc thanh toán.</p></div></div></section>
