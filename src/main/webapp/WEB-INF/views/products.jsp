<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">${adminView ? 'KHÔNG GIAN QUẢN TRỊ' : 'TỦ SÁCH GÓC'}</p><h1>${adminView ? 'Quản lý sản phẩm' : 'Tìm một cuốn sách cho mình.'}</h1><p class="muted"><c:out value="${catalog.total}"/> cuốn sách · 6 sản phẩm mỗi trang · Mới nhất trước</p></div><c:if test="${adminView}"><a class="btn btn-forest" href="<c:url value='/admin/product/add'/>">+ Thêm sách</a></c:if></div>
<c:choose><c:when test="${adminView}"><div class="table-responsive panel"><table class="table align-middle"><thead><tr><th>Mã</th><th>Sách</th><th>Danh mục</th><th>Tồn kho</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${catalog.items}" var="book"><tr><td>#<c:out value="${book.id}"/></td><td><a href="<c:url value='/product/detail'><c:param name='id' value='${book.id}'/></c:url>"><c:out value="${book.title}"/></a></td><td><c:out value="${book.categoryName}"/></td><td><c:out value="${book.stock}"/></td><td><div class="table-actions"><a href="<c:url value='/admin/product/edit'><c:param name='id' value='${book.id}'/></c:url>">Chỉnh sửa</a><form method="post" action="<c:url value='/admin/product/delete'/>"><input type="hidden" name="_csrf" value="<c:out value='${csrf}'/>"><input type="hidden" name="id" value="<c:out value='${book.id}'/>"><button class="link-button danger">Xóa</button></form></div></td></tr></c:forEach><c:if test="${empty catalog.items}"><tr><td colspan="5" class="empty-state">Chưa có sách.</td></tr></c:if></tbody></table></div></c:when><c:otherwise><c:set var="products" value="${catalog.items}" scope="request"/><jsp:include page="book-cards.jsp"/></c:otherwise></c:choose>
<nav class="page-nav" aria-label="Phân trang"><c:forEach begin="${catalog.number > 2 ? catalog.number - 2 : 1}" end="${catalog.pages < catalog.number + 2 ? catalog.pages : catalog.number + 2}" var="n"><c:url var="pageUrl" value="${adminView ? '/admin/products' : '/product'}"><c:param name="page" value="${n}"/></c:url><a href="<c:out value='${pageUrl}'/>" class="${n == catalog.number ? 'selected' : ''}" aria-label="Trang ${n}">${n}</a></c:forEach><span>Trang ${catalog.number} / ${catalog.pages}</span></nav></section>
